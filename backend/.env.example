# Copy to .env and fill in. See README for details.

# --- LLM (pick one) ---
# Free hosted tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fully open source, self-hosted (https://ollama.com):
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5vl:7b

# --- Image generation (optional; providers tried in this order) ---
# SD_WEBUI_URL=http://127.0.0.1:7860
# OPENAI_API_KEY=

# --- Storage (optional; JSON file store used automatically if unreachable) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=omniscan
